{
  "name": "idea-forge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43123 --hostname 0.0.0.0 --webpack",
    "dev:stop": "pkill -f 'next dev --port 43123' 2>/dev/null || true",
    "dev:restart": "npm run dev:stop && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:app-validate": "npx --yes tsx --test src/lib/app-validate.test.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true && chmod +x scripts/push-remotes.sh .githooks/post-commit 2>/dev/null || true",
    "push:github": "bash scripts/push-remotes.sh"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.31",
    "@next/swc-darwin-x64": "^16.3.4",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
